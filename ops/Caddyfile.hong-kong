# Temporary full-site hosting. EdgeOne can later replace only the app DNS record.
api.bilabang.cloud {
    request_body {
        max_size 50MB
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
    reverse_proxy 127.0.0.1:5188
}

app.bilabang.cloud {
    root * /var/www/bilabang/current
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Cache-Control no-cache
        -Server
    }
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"
    try_files {path} /index.html
    file_server
}

bilabang.cloud, www.bilabang.cloud {
    redir https://app.bilabang.cloud{uri} permanent
}
