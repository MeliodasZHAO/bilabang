# Temporary full-site hosting. EdgeOne can later replace only the app DNS record.
api.bilabang.com {
    request_body {
        max_size 50MB
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
    reverse_proxy 127.0.0.1:5188
}

bilabang.com {
    root * /var/www/bilabang/current
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Cache-Control no-cache
        -Server
    }
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"
    try_files {path} /index.html
    file_server
}

bilabang.cn, www.bilabang.cn, www.bilabang.com, bilabang.cloud, www.bilabang.cloud, app.bilabang.cloud {
    redir https://bilabang.com{uri} 308
}

api.bilabang.cloud {
    redir https://api.bilabang.com{uri} 308
}
