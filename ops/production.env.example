# Copy to /etc/bilabang/production.env on the server; never commit real secrets.
NODE_ENV=production
HOST=127.0.0.1
PORT=5188
SITE_URL=https://app.bilabang.com
API_ORIGIN=https://api.bilabang.com
DATA_DIR=/var/lib/bilabang
RATE_SALT=REPLACE_WITH_RANDOM_SECRET
# Enable only behind the supplied Caddy proxy, which overwrites forwarding headers.
TRUST_PROXY=1
